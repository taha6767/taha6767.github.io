{
  "name": "taha-disbudak-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio site for Taha Disbudak",
  "private": true,
  "scripts": {
    "compile:scss": "sass sass/main.scss css/style.css --no-source-map",
    "watch:scss": "sass --watch sass/main.scss css/style.css --no-source-map",
    "compress:css": "sass sass/main.scss css/style.css --no-source-map --style=compressed",
    "build": "npm-run-all compile:scss prefix:css compress:css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.css -o css/style.css",
    "serve": "python3 -m http.server 8000"
  },
  "author": "Taha Disbudak",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  }
}
